{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"]
  },
   
  "include": ["src/**/*.ts", "scripts/**/*.ts", "src/components/dashboard/Toasts.vue", "src/components/dashboard/startCard.vue"]
}
